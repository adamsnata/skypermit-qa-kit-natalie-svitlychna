{
  "permissions": {
    "allow": [
      "Bash(node scripts/uncovered-rules.mjs:*)",
      "Read(../skypermit/**)",
      "Edit(./test-cases/**)"
    ],
    "deny": [
      "Read(//c/Users/natal/.ssh/**)",
      "Edit(../skypermit/**)",
      "Write(../skypermit/**)",
      "WebFetch",
      "WebSearch",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-test-case.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage-report.mjs\""
          }
        ]
      }
    ]
  }
}
